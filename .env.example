# JobTech Dev (Arbetsförmedlingen) — public, no API key required.
# Comma-separated free-text title queries; defaults to a built-in IT/Business/Data/Cybersecurity set.
# JOBTECH_QUERIES=software engineer,systemutvecklare,data,cybersakerhet,it,business,analytiker
# JOBTECH_MUNICIPALITY_CODE=1480

# Greenhouse and Lever public job boards — no API key required.
# Comma-separated board slugs; leave unset to use the ~58 verified boards (Nordics, Europe, remote-heavy).
# GREENHOUSE_BOARDS=wolt,truecaller
# LEVER_BOARDS=spotify,tomtom

# Optional sources
# Cinode Market (market.cinode.com) is public and needs no credentials; set to
# false to switch the source off.
CINODE_MARKET_ENABLED=true

THEIRSTACK_API_KEY=

DATABASE_PATH=./data/jobs.db
PORT=4000

# Local semantic CV<->opening matching (Ollama + Chroma). Defaults assume
# `docker compose up` (or a local Ollama/Chroma install) on these ports.
# See README "Local semantic matching" for the one-time model pull step.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# MATCH_TOP_K=10   # unset = no limit, consider all jobs
# MATCH_MIN_SIMILARITY=0.5

# Bounds on the local model so it can't silently truncate a long CV/job ad
# (OLLAMA_NUM_CTX too low) or run away generating for minutes on a call that
# doesn't cleanly stop (OLLAMA_NUM_PREDICT left at -1/unbounded). See README
# "Tuning Ollama's context/output limits".
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=-1

# Vector fallback for the title scope filter: titles that don't match
# TARGET_ROLES exactly (packages/domain/src/target-roles.ts) but embed close
# to a known role phrase are accepted too, and folded back into the
# ever-growing `target_role_phrases` table/collection.
# ROLE_MATCH_MIN_SIMILARITY=0.85

# Skill taxonomy for match scoring (see ADR 0009): raw skill strings from a
# job/CV are folded into a canonical `skills` vocabulary the same way (exact
# formatting-normalized match first, then vector similarity fallback that
# also learns cross-language/near-variant spellings). SKILL_OVERLAP_WEIGHT
# is how much of the final match score is required-skill coverage vs. raw
# whole-document embedding similarity.
# SKILL_MATCH_MIN_SIMILARITY=0.82
# SKILL_OVERLAP_WEIGHT=0.6

# Role-category sanity check for match scoring (see ADR 0012): a job's and a
# candidate's title are each classified into a coarse role family (engineer,
# designer, product manager, ...). When both are known and incompatible
# (e.g. a designer CV against a product-manager job), the final score is
# multiplied by ROLE_MISMATCH_PENALTY. NO_REQUIRED_SKILLS_PENALTY is a
# separate discount applied whenever a job has zero extracted required
# skills, since scoring then falls back to semantic similarity alone.
# ROLE_MISMATCH_PENALTY=0.5
# NO_REQUIRED_SKILLS_PENALTY=0.75

# Seniority-level sanity check (added in the 2026-09-22 matching-quality
# audit): a job's and a candidate's title/experience text are each
# classified into a coarse level (junior, mid, senior, lead-principal).
# When both are known and more than one step apart (e.g. a junior CV
# against a lead-principal posting), the final score is multiplied by
# SENIORITY_MISMATCH_PENALTY. MIN_SKILLS_FOR_FULL_CONFIDENCE dampens
# SKILL_OVERLAP_WEIGHT proportionally when a job has fewer required skills
# than this, since a single lucky match (skillCoverage 1/1) is weaker
# evidence of fit than the same ratio over many skills.
# SENIORITY_MISMATCH_PENALTY=0.7
# MIN_SKILLS_FOR_FULL_CONFIDENCE=3