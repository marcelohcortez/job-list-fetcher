{
  "name": "job-list-fetcher-monorepo",
  "version": "1.0.0",
  "description": "Gothenburg IT & Business job discovery platform shipping a local-first API.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run dev --workspace @job-fetcher/api",
    "web": "npm run dev --workspace @job-fetcher/web -- --port 4001",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/luxon": "^3.4.0",
    "@types/node": "^20.14.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.3.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
