# Job List Fetcher - Environment Variables

# API Configuration
PORT=4000
DATABASE_PATH=./data/jobs.db

# JobTech Dev (Arbetsförmedlingen) configuration
JOBTECH_QUERIES=
JOBTECH_MUNICIPALITY_CODE=1480

# Greenhouse configuration
GREENHOUSE_BOARDS=

# Lever configuration  
LEVER_BOARDS=

# TheirStack configuration
THEIRSTACK_API_KEY=

# Cinode Market (market.cinode.com) is public and needs no credentials; set to
# false to switch the source off.
CINODE_MARKET_ENABLED=true

# Optional: Custom target roles
TARGET_ROLES=

# Local semantic CV<->opening matching (Ollama + Chroma)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# MATCH_TOP_K=10   # unset = no limit, consider all jobs
# MATCH_MIN_SIMILARITY=0.65
# ROLE_MATCH_MIN_SIMILARITY=0.85
# SKILL_MATCH_MIN_SIMILARITY=0.82
# SKILL_OVERLAP_WEIGHT=0.6
# ROLE_MISMATCH_PENALTY=0.5
# NO_REQUIRED_SKILLS_PENALTY=0.75
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=-1