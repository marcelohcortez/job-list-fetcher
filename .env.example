# JobTech Dev (Arbetsförmedlingen) — public, no API key required.
# Comma-separated free-text title queries; defaults to a built-in IT/Business/Data/Cybersecurity set.
# JOBTECH_QUERIES=software engineer,systemutvecklare,data,cybersakerhet,it,business,analytiker
# JOBTECH_MUNICIPALITY_CODE=1480

# Greenhouse and Lever public job boards — no API key required.
# Comma-separated board slugs; leave unset to use the ~58 verified boards (Nordics, Europe, remote-heavy).
# GREENHOUSE_BOARDS=wolt,truecaller
# LEVER_BOARDS=spotify,tomtom

# Optional sources
# Cinode Market (market.cinode.com) is public and needs no credentials; set to
# false to switch the source off.
CINODE_MARKET_ENABLED=true

CINODE_ACCESS_ID=
CINODE_ACCESS_SECRET=
CINODE_COMPANY_ID=
THEIRSTACK_API_KEY=

DATABASE_PATH=./data/jobs.db
PORT=4000